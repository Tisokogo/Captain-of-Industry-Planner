{
  "name": "harbor-production-planner",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:progression": "node scripts/validate-progression.mjs",
    "validate:capabilities": "python scripts/build_capabilities.py --check && node scripts/validate-capabilities.mjs",
    "build:progression": "python scripts/build_recipe_progression.py",
    "build:capabilities": "python scripts/build_capabilities.py",
    "build:data-manifest": "python scripts/build_data_manifest.py",
    "import:current-data": "node scripts/import_current_export.mjs",
    "validate:data-manifest": "python scripts/build_data_manifest.py --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run validate:data && npm run validate:progression && npm run validate:capabilities && npm run validate:data-manifest && vite build"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
